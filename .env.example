# GE-EHR environment configuration. Copy to `.env` (git-ignored) and adjust.
# Every value here is optional in development; ProductionConfig refuses to start without SECRET_KEY.

# Which configuration class to use: development | testing | production
FLASK_CONFIG=development

# Flask CLI entry point (used by `flask init-db`, `flask seed-demo`, ...)
FLASK_APP=wsgi

# Long random string; generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database URL. Defaults to SQLite at instance/ge_ehr.db when unset.
# postgres:// URLs (as issued by some hosting providers) are rewritten to postgresql://.
# DATABASE_URL=postgresql://ge_ehr:password@localhost:5432/ge_ehr

# Password given to the demo users created by `flask seed-demo`.
DEMO_PASSWORD=Demo-Pass-2026!

# Source of the scheduled `flask clinvar sync` job (NCBI ClinVar GRCh38 aggregate VCF).
CLINVAR_SYNC_URL=https://ftp.ncbi.nlm.nih.gov/pub/clinvar/vcf_GRCh38/clinvar.vcf.gz

# Number of reverse proxies in front of the app whose X-Forwarded-* headers are trusted
# (production defaults to 1, e.g. on Render; development and testing default to 0).
# TRUSTED_PROXIES=1

# Log level of the ge_ehr loggers: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
