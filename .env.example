# GE-EHR environment configuration (local install). Copy this file to `.env` in the project
# folder (it is git-ignored) and adjust; every setting is optional — without a .env file GE-EHR
# runs with the defaults described below.
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# Configuration class: development (default) | production | testing
FLASK_CONFIG=development

# Flask CLI entry point, so `flask init-db`, `flask seed-demo`, ... work without `--app wsgi`.
FLASK_APP=wsgi

# Secret used to sign login sessions. Leave it unset for a local install: `python run.py` then
# generates a random key once and keeps it in instance/secret_key (delete that file to sign
# everybody out). The production configuration refuses to start without SECRET_KEY. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Database. Default: the SQLite file instance/ge_ehr.db (created by `python run.py` or
# `flask init-db`). Optional PostgreSQL server instead — install its driver first with
#   python -m pip install psycopg2-binary
# and point DATABASE_URL at it (postgres:// is rewritten to postgresql://):
# DATABASE_URL=postgresql://ge_ehr:password@localhost:5432/ge_ehr
# DATABASE_URL=sqlite:///C:/GE-EHR/ge_ehr.db

# Password given to the demo users (admin, dr.rao, lab.kim) created by `flask seed-demo`.
DEMO_PASSWORD=Demo-Pass-2026!

# VCF reader: auto (default: cyvcf2 when installed, else the built-in pure-Python reader, e.g. on
# Windows where cyvcf2 cannot be installed) | cyvcf2 (require it) | python (always built-in).
# Both readers give identical results.
# GE_EHR_VCF_BACKEND=auto

# Source of `flask clinvar sync` (NCBI ClinVar GRCh38 aggregate VCF; needs internet access).
CLINVAR_SYNC_URL=https://ftp.ncbi.nlm.nih.gov/pub/clinvar/vcf_GRCh38/clinvar.vcf.gz

# Number of reverse proxies in front of GE-EHR whose X-Forwarded-* headers are trusted. Keep 0
# for a local install (development default); the production configuration assumes 1.
# TRUSTED_PROXIES=0

# Log level of the ge_ehr loggers: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
